rules_version = '2';

// Junction — who can read and write what.
//   users/{uid}               a player's own profile (name, live code)          owner only
//   users/{uid}/saves/{slot}  five save slots per game mode ("standard-1" ...)   owner only
//   users/{uid}/friends/{fid} the players someone has added as friends          owner only
//   usernames/{nameLower}     every player's name (guests and accounts)        readable by players; see below
//   leaderboard/{uid}         personal bests                                   everyone reads, owner writes
//   boards/{mode}/players/{uid}   per-mode leaderboards                        everyone reads, owner writes
//   expert/{week}/players/{uid}   weekly Expert Survival runs (+ city layout)  everyone reads, owner writes
//   messages/{id}             player-to-player messages                        only sender and recipient read
//   live/{code}               live-view channel                                read by code only (no listing)
//   feedback/{cat}/entries    guest feedback (bugs / ideas / other)            create only; read in the console
//   profiles/{uid}            a player's public card (name, live code)         everyone reads, owner writes
//   challenges/{id}           ISO 1v1 matches (+ live/{uid} city snapshots)   only the two players
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    // Google and email accounts carry an email claim; anonymous guests don't.
    function registered() { return signedIn() && ('email' in request.auth.token); }
    function validName(n) { return n is string && n.matches('^[A-Za-z0-9_-]{3,16}$'); }
    function nameDoc(lower) { return /databases/$(database)/documents/usernames/$(lower); }

    function validUser(uid) {
      let d = request.resource.data;
      let lower = d.nameLower;
      return d.keys().hasOnly(['name', 'nameLower', 'star', 'liveCode', 'updatedAt'])
        && validName(d.name)
        && lower == d.name.lower()
        && d.star == registered()
        && (!('liveCode' in d) || d.liveCode == null || (d.liveCode is string && d.liveCode.matches('^[0-9]{6}$')))
        // accounts must hold the reservation for their name; guests can't use a reserved name
        && (registered()
              ? (existsAfter(nameDoc(lower)) && getAfter(nameDoc(lower)).data.uid == uid)
              : (!existsAfter(nameDoc(lower)) || getAfter(nameDoc(lower)).data.uid == uid))
        // a permanent account's name never changes
        && (resource == null || !resource.data.star || resource.data.nameLower == lower);
    }

    match /users/{uid} {
      allow get: if isMe(uid);
      allow create, update: if isMe(uid) && validUser(uid);

      match /saves/{slot} {
        allow get, list, delete: if isMe(uid);
        allow create, update: if isMe(uid)
          // five per game mode; the old shared slots 1-5 can still be read and deleted while they're moved over
          && slot.matches('^(chill|standard|frantic|zen|expert)-[1-5]$')
          && request.resource.data.keys().hasOnly(['data', 'score', 'week', 'diffKey', 'over', 'updatedAt'])
          && (!('data' in request.resource.data)
              || (request.resource.data.data is string && request.resource.data.data.size() < 1000000));
      }

      // lifetime stats and achievements, mirrored from the browser
      match /stats/{sid} {
        allow get: if isMe(uid);
        allow create, update: if isMe(uid) && (
          (sid == 'life' && request.resource.data.keys().hasOnly(['modes', 'ach', 'updatedAt']))
          || (sid == 'shop' && request.resource.data.keys().hasOnly(['v', 'bucks', 'toward', 'rbucks', 'owned', 'hired', 'designs', 'streak', 'prof', 'quests', 'updatedAt'])
              && request.resource.data.bucks is int && request.resource.data.bucks >= 0 && request.resource.data.bucks < 100000000));
      }

      // players this one has blocked or muted
      match /blocked/{bid} {
        allow get, list, delete: if isMe(uid);
        allow create, update: if isMe(uid) && bid != uid
          && request.resource.data.keys().hasOnly(['name', 'mute', 'at'])
          && request.resource.data.mute is bool;
      }

      match /friends/{fid} {
        allow get, list, delete: if isMe(uid);
        allow create, update: if isMe(uid) && fid != uid
          && request.resource.data.keys().hasOnly(['name', 'at'])
          && validName(request.resource.data.name);
      }
    }

    // Every name is reserved here: {uid, perm, at}. perm is true for accounts (theirs for good) and false for
    // guests, whose name frees up for someone else after 30 days unused. Older reservations hold only {uid}
    // and count as accounts'.
    function validReservation() {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'perm', 'at'])
        && d.uid == request.auth.uid
        && d.perm == registered()
        && d.at == request.time;
    }
    function guestNameExpired() {
      return resource.data.get('perm', true) == false
        && resource.data.get('at', null) is timestamp
        && request.time > resource.data.at + duration.value(30, 'd');
    }
    match /usernames/{lower} {
      allow get: if signedIn();
      allow create: if signedIn() && lower.matches('^[a-z0-9_-]{3,16}$') && validReservation();
      // the holder refreshes it (or a guest who made an account makes it permanent); anyone may take an expired guest name
      allow update: if signedIn() && validReservation()
        && (resource.data.uid == request.auth.uid || guestNameExpired());
      // the holder lets it go (a guest changing name)
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    function validBoard(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'star', 'parcels', 'parcelsDiff', 'weeks', 'weeksDiff', 'goalsSec', 'goalsDiff', 'updatedAt'])
        && d.name == get(/databases/$(database)/documents/users/$(uid)).data.name
        && d.star == registered()
        && d.parcels is int && d.parcels >= 0 && d.parcels < 10000000
        && d.weeks is int && d.weeks >= 0 && d.weeks < 100000
        && (!('goalsSec' in d) || (d.goalsSec is int && d.goalsSec > 0));
    }

    match /leaderboard/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid) && validBoard(uid);
      allow delete: if isMe(uid);
    }

    match /live/{code} {
      // Only fetchable by exact code — nobody can list codes to find other players.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.matches('^[0-9]{6}$')
        && request.resource.data.uid == request.auth.uid
        && (!('state' in request.resource.data) || request.resource.data.state == null
            || (request.resource.data.state is string && request.resource.data.state.size() < 1000000));
      allow update: if signedIn() && (
        // the owner updates their own channel
        (resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid)
        // a viewer may only stamp "someone is watching"
        || (resource.data.uid != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['watchT'])));
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Per-mode leaderboards: one document per player per mode.
    match /boards/{mode}/players/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid) && mode in ['chill', 'standard', 'frantic', 'zen']
        && request.resource.data.keys().hasOnly(['name', 'star', 'ach3', 'title', 'frame', 'parcels', 'weeks', 'goalsSec', 'playSec', 'earned', 'updatedAt'])
        && validName(request.resource.data.name);
      allow delete: if isMe(uid);
    }

    // Weekly Expert Survival: each player's best run on that ISO week's seed, with a compact copy of the city.
    match /expert/{week}/players/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid) && week.matches('^[0-9]{4}-W[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['name', 'star', 'ach3', 'title', 'frame', 'parcels', 'weeks', 'earned', 'trips', 'tows', 'cars', 'roads', 'playSec',
                                                'seedName', 'seedCode', 'weekLabel', 'city', 'updatedAt'])
        && validName(request.resource.data.name)
        && request.resource.data.parcels is int && request.resource.data.parcels >= 0 && request.resource.data.parcels < 10000000
        && request.resource.data.weeks is int && request.resource.data.weeks >= 0 && request.resource.data.weeks < 100000
        && request.resource.data.city is string && request.resource.data.city.size() < 400000;
      allow delete: if isMe(uid);
    }

    // Messages between players. Only the sender and the recipient can read one; only the recipient can
    // mark it read; either of them can delete it.
    match /messages/{id} {
      allow read: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'toName', 'text', 'at', 'read'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to.size() > 0 && request.resource.data.to.size() < 128
        && request.resource.data.to != request.auth.uid
        && validName(request.resource.data.fromName)
        && request.resource.data.toName is string && request.resource.data.toName.size() <= 16
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && request.resource.data.at == request.time
        && request.resource.data.read == false;
      allow update: if signedIn() && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }

    // A player's public card, so others can open them from a leaderboard and watch their game.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'star', 'ach3', 'live', 'banner', 'frame', 'title', 'pins', 'updatedAt'])
        && !('flag' in request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys())
        && validName(request.resource.data.name)
        && (!('pins' in request.resource.data) || (request.resource.data.pins is list && request.resource.data.pins.size() <= 3))
        && (request.resource.data.live == null || (request.resource.data.live is string && request.resource.data.live.matches('^[0-9]{6}$')));
      allow delete: if isMe(uid);
    }

    // ISO 1v1 matches. Only the two players can see or change one; the players and seed never change, and each
    // player can only write their own result.
    function inMatch(d) { return signedIn() && (d.from == request.auth.uid || d.to == request.auth.uid); }
    match /challenges/{id} {
      allow read: if inMatch(resource.data);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'toName', 'kind', 'seed', 'status', 'createdAt', 'expiresAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to.size() > 0 && request.resource.data.to.size() < 128
        && request.resource.data.to != request.auth.uid
        && validName(request.resource.data.fromName)
        && request.resource.data.toName is string && request.resource.data.toName.size() <= 16
        && request.resource.data.kind in ['live', 'daily']
        && request.resource.data.seed is int
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp;
      allow update: if inMatch(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'expiresAt', 'ready', 'startAt', 'ctl', 'prop', 'res', 'winner', 'reason', 'endedAt'])
        && !(resource.data.get('ranked', false) && request.resource.data.status == 'cancelled')
        && request.resource.data.get('res', {}).diff(resource.data.get('res', {})).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.get('ready', {}).diff(resource.data.get('ready', {})).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.status in ['pending', 'accepted', 'declined', 'cancelled', 'done'];
      allow delete: if inMatch(resource.data);

      match /live/{uid} {
        allow read: if inMatch(get(/databases/$(database)/documents/challenges/$(id)).data);
        allow create, update: if isMe(uid) && inMatch(get(/databases/$(database)/documents/challenges/$(id)).data)
          && request.resource.data.keys().hasOnly(['city', 'sec', 'parcels', 'week', 'earned', 'trips', 'tows', 'over', 'at'])
          && request.resource.data.city is string && request.resource.data.city.size() < 400000;
        allow delete: if isMe(uid);
      }
    }

    // Ranked ISO. Ratings are written only by the Cloud Functions; players may only queue (one doc, their own)
    // and sign up to tournaments. Challenge docs with ranked: true are created by the functions.
    match /rankedPlayers/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /rankedQueue/{uid} {
      allow read: if isMe(uid);
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'rating', 'kind', 'at'])
        && validName(request.resource.data.name)
        && request.resource.data.kind in ['live', 'daily']
        && request.resource.data.at == request.time;
      allow delete: if isMe(uid);
    }
    match /rankedLimits/{uid} { allow read, write: if false; }
    match /tournaments/{id} {
      allow read: if signedIn();
      allow create: if registered()
        && request.resource.data.keys().hasOnly(['name', 'size', 'kind', 'host', 'hostName', 'status', 'rounds', 'startsAt', 'createdAt'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.size in [8, 16]
        && request.resource.data.kind in ['live', 'daily']
        && request.resource.data.status == 'signup'
        && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 32;
      allow update, delete: if false;
      match /signups/{uid} {
        allow read: if signedIn();
        allow create, update: if isMe(uid) && request.resource.data.keys().hasOnly(['name', 'rating', 'at']) && validName(request.resource.data.name);
        allow delete: if isMe(uid);
      }
    }
    // server-granted items (season rewards): read by the owner, written by the functions
    match /users/{uid}/stats/grants { allow get: if isMe(uid); allow write: if false; }
    // error reports: create only, rate limited by the functions
    match /logs/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['kind', 'uid', 'msg', 'where', 'ver', 'ua', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind == 'error'
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 500;
      allow read, update, delete: if false;
    }

    // Community maps. maps/{code} is a published map: anyone signed in can read it, only its author can change or
    // delete it, and other players may only count a like (+-1) or a play (+1) on it. maps/{code}/likes/{uid} marks
    // a like (only the liker adds or removes theirs) and maps/{code}/runs/{uid} is a player's best run on the map,
    // with a compact copy of their city, like the weekly Expert runs.
    function validMapDoc() {
      let d = request.resource.data;
      return d.keys().hasOnly(['code', 'name', 'desc', 'data', 'author', 'authorName', 'mode', 'goalText', 'likes', 'plays', 'createdAt', 'updatedAt', 'thumb'])
        && d.code is string && d.code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && d.name is string && d.name.size() >= 3 && d.name.size() <= 32
        && d.desc is string && d.desc.size() <= 140
        && d.data is string && d.data.size() > 0 && d.data.size() <= 40000
        && validName(d.authorName)
        && d.mode in ['chill', 'standard', 'frantic']
        && d.goalText is string && d.goalText.size() <= 80
        && d.likes is int && d.likes >= 0 && d.plays is int && d.plays >= 0
        && d.thumb is string && d.thumb.size() <= 8192;
    }
    match /maps/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && validMapDoc()
        && request.resource.data.code == code
        && request.resource.data.author == request.auth.uid
        && request.resource.data.likes == 0 && request.resource.data.plays == 0
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && validMapDoc()
        && request.resource.data.code == resource.data.code
        && request.resource.data.author == resource.data.author
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.likes - resource.data.likes) in [-1, 0, 1]
        && (request.resource.data.plays - resource.data.plays) in [0, 1]
        // the author edits the map (and may like or play it too); anyone else only counts a like or a play
        && (resource.data.author == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'plays']));
      allow delete: if signedIn() && resource.data.author == request.auth.uid;

      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if isMe(uid) && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
        allow delete: if isMe(uid);
      }

      match /runs/{uid} {
        allow read: if signedIn();
        allow create, update: if isMe(uid)
          && request.resource.data.keys().hasOnly(['name', 'star', 'ach3', 'title', 'frame', 'parcels', 'weeks', 'earned', 'playSec', 'goal', 'city', 'updatedAt'])
          && validName(request.resource.data.name)
          && request.resource.data.parcels is int && request.resource.data.parcels >= 0 && request.resource.data.parcels < 10000000
          && request.resource.data.weeks is int && request.resource.data.weeks >= 0 && request.resource.data.weeks < 100000
          && request.resource.data.goal is bool
          && request.resource.data.city is string && request.resource.data.city.size() < 400000;
        allow delete: if isMe(uid);
      }
    }

    // Co-op cities. The host owns the session doc and writes the city into it; invited players add and remove
    // themselves under members (only their own entry), send build actions the host applies, and share cursors.
    function coopData(id) { return get(/databases/$(database)/documents/coop/$(id)).data; }
    function coopMember(d) { return signedIn() && (d.host == request.auth.uid || request.auth.uid in d.members); }
    function coopCan(d) { return coopMember(d) || (signedIn() && request.auth.uid in d.invited); }
    function validCoop() {
      let d = request.resource.data;
      return d.keys().hasOnly(['host', 'hostName', 'members', 'invited', 'status', 'seed', 'mode', 'createdAt', 'updatedAt', 'state', 'stateAt', 'meta', 'expireAt'])
        && d.host == request.auth.uid
        && validName(d.hostName)
        && d.members is map && d.invited is list && d.invited.size() <= 40
        && d.status in ['open', 'playing', 'ended']
        && d.mode in ['chill', 'standard', 'frantic', 'zen', 'expert']
        && (!('state' in d) || d.state == null || (d.state is string && d.state.size() < 1000000));
    }
    match /coop/{id} {
      allow read: if signedIn() && (resource.data.host == request.auth.uid || request.auth.uid in resource.data.members || request.auth.uid in resource.data.invited);
      allow create: if signedIn() && validCoop() && request.resource.data.status != 'ended';
      allow update: if signedIn() && (
        // the host changes anything (but stays the host)
        (resource.data.host == request.auth.uid && validCoop())
        // a member or invitee only joins or leaves: their own entry under members
        || (coopCan(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])));
      allow delete: if signedIn() && resource.data.host == request.auth.uid;

      match /actions/{aid} {
        allow read: if coopMember(coopData(id));
        allow create: if coopMember(coopData(id))
          && request.resource.data.keys().hasOnly(['by', 'name', 't', 'seq', 'act', 'k', 'k2', 'kind', 'payload', 'at'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.act in ['road', 'erase', 'special', 'moto', 'park', 'depot', 'sign', 'oneway', 'upjunc', 'upstore', 'tow', 'car', 'buy', 'emote']
          && request.resource.data.k is int && request.resource.data.k2 is int
          && request.resource.data.kind is string && request.resource.data.kind.size() <= 16
          && (request.resource.data.payload == null || (request.resource.data.payload is string && request.resource.data.payload.size() <= 32))
          && request.resource.data.t is number && request.resource.data.at == request.time;
        // the host marks an action applied (or refused, with a short note)
        allow update: if coopData(id).host == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'ok', 'note'])
          && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 160));
        allow delete: if coopData(id).host == request.auth.uid;
      }
      match /cursors/{uid} {
        allow read: if coopMember(coopData(id));
        allow create, update: if isMe(uid) && coopMember(coopData(id))
          && request.resource.data.keys().hasOnly(['x', 'y', 'name', 'colour', 'at'])
          && request.resource.data.x is number && request.resource.data.y is number
          && request.resource.data.name is string && request.resource.data.name.size() <= 16
          && request.resource.data.colour is string && request.resource.data.colour.size() <= 12;
        allow delete: if isMe(uid) || coopData(id).host == request.auth.uid;
      }
    }

    // The installed apps hand a Google sign-in back from a browser tab (p68). The code is a 40-character random string only
    // the app and its own browser tab know, so a document can be fetched by its id but never listed; the app deletes it at once.
    match /authHandoff/{code} {
      allow get: if request.auth != null && code.size() >= 40;
      allow list, update: if false;
      allow create: if request.auth != null && code.size() >= 40
        && request.resource.data.keys().hasOnly(['idToken', 'at'])
        && request.resource.data.idToken is string && request.resource.data.idToken.size() < 5000
        && request.resource.data.at == request.time;
      allow delete: if request.auth != null;
    }

    // Guests' feedback. Players can add a note but nobody can read, edit or delete
    // them from the game — you read them in the Firebase console.
    function validFeedback() {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'name', 'message', 'details', 'replyTo', 'about', 'aboutName', 'createdAt'])
        && d.uid == request.auth.uid
        && (!('about' in d) || (d.about is string && d.about.size() < 128))
        && (!('aboutName' in d) || (d.aboutName is string && d.aboutName.size() <= 16))
        && d.message is string && d.message.size() >= 3 && d.message.size() <= 1500
        && (!('details' in d) || (d.details is string && d.details.size() <= 2000))
        && (!('name' in d) || validName(d.name))
        && (!('replyTo' in d) || (d.replyTo is string && d.replyTo.size() <= 254
              && d.replyTo.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')))
        && d.createdAt == request.time;
    }

    match /feedback/{category}/entries/{id} {
      allow create: if signedIn() && category in ['bugs', 'ideas', 'other'] && validFeedback();
      allow read, update, delete: if false;
    }
  }
}
